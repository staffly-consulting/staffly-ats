# Copy to .env.local and fill in. Never commit .env.local.

# --- Clerk (authentication + organizations) ---------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# From Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret.
# The svix signature check in /api/webhooks/clerk fails closed without it.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
# Where Clerk's prebuilt components live and where to land afterwards.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser; row-level
# security is what actually gates access.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Bypasses RLS — never import into client code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Database (Prisma) ------------------------------------------------------
# DATABASE_URL: pooled (pgBouncer, 6543). Used at runtime by the driver adapter
#   in src/lib/prisma.ts.
# DIRECT_URL:   un-pooled (5432). Used by the Prisma CLI via prisma.config.ts.
#   Migrations need a real session, which transaction pooling cannot give them.
# Both connect as the database owner, which BYPASSES row-level security — see
# prisma/migrations/*_rls_policies/migration.sql.
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# --- Claude -----------------------------------------------------------------
# Used by the extraction and scoring steps.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Inngest ----------------------------------------------------------------
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="signkey-prod-..."

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY="re_..."
# Resend Dashboard -> Webhooks -> your inbound endpoint -> Signing Secret.
# Resend signs webhooks with Svix; /api/webhooks/resend-inbound fails closed
# without this.
RESEND_WEBHOOK_SECRET="whsec_..."
# Domain the generated forwarding aliases live on. Must match the domain you
# configured for inbound parsing in Resend, e.g. "{org}-{id}@mail.staffly.com".
INBOUND_EMAIL_DOMAIN="mail.staffly.com"
# Sender for outbound notifications. Must be on a domain verified in Resend, or
# every send is rejected. Leave unset to disable outbound mail entirely — the
# notification function logs a skip rather than failing.
RESEND_FROM_EMAIL="Staffly ATS+ <notifications@mail.staffly.com>"

# --- App ---------------------------------------------------------------------
# Used to build absolute links in outbound email.
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# --- Stripe (billing) --------------------------------------------------------
# NONE of these have fallbacks. A missing price id would put a customer on the
# wrong plan or bill them nothing, so every getter in src/lib/stripe.ts throws
# with the name of the variable that is absent.
#
# Billing is all-or-nothing: background jobs skip quietly while the whole set is
# absent, and fail loudly once it is partially present.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Flat recurring prices, one per tier x interval. Annual is ~17% off.
STRIPE_PRICE_SHORTLIST_MONTHLY="price_..."      # $79/mo
STRIPE_PRICE_SHORTLIST_ANNUAL="price_..."       # ~$787/yr
STRIPE_PRICE_PIPELINE_MONTHLY="price_..."       # $250/mo
STRIPE_PRICE_PIPELINE_ANNUAL="price_..."        # ~$2,490/yr
STRIPE_PRICE_TALENT_POOL_MONTHLY="price_..."    # $499/mo
STRIPE_PRICE_TALENT_POOL_ANNUAL="price_..."     # ~$4,970/yr

# Metered overage prices (Billing Meters API, not legacy usage records).
STRIPE_PRICE_SHORTLIST_OVERAGE="price_..."      # $0.70 per application
STRIPE_PRICE_PIPELINE_OVERAGE="price_..."       # $0.50
STRIPE_PRICE_TALENT_POOL_OVERAGE="price_..."    # $0.35

# The meter all three overage prices are bound to.
STRIPE_METER_EVENT_NAME="application_overage"
